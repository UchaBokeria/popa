{
  "name": "popa",
  "version": "1.0.0",
  "description": "SSR web app for Popa",
  "module": "http.ts",
  "type": "module",
  "scripts": {
    "start": "bun  --watch http.ts",
    "build:dev": "bun build http.ts --target node --outdir dist",
    "build:css": "tailwindcss -i src/views/styles/tailwind.css -o public/styles/tailwind.css",
    "build": "bun build http.ts --target node --outdir dist --minify",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --apply .",
    "test": "bun test",
    "prepare": "husky",
    "typeorm": "typeorm-ts-node-esm",
    "db:generate": "bun run src/utils/database/migration/index.ts generate",
    "db:run": "bun run src/utils/database/migration/index.ts run",
    "db:revert": "bun run src/utils/database/migration/index.ts revert"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome format --write",
      "biome lint --apply"
    ],
    "*.{json,css,html}": [
      "biome format --write"
    ]
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.0",
    "alpinejs": "^3.14.9",
    "bcrypt": "^5.1.1",
    "daisyui": "^5.0.43",
    "dotenv": "^16.5.0",
    "elysia": "^1.3.4",
    "elysia-nest": "^0.7.4",
    "handlebars": "^4.7.8",
    "htmx.org": "^1.9.12",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "typeorm": "^0.3.24",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.5.3",
    "@elysiajs/cors": "^1.3.3",
    "@sinclair/typebox": "^0.34.33",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}