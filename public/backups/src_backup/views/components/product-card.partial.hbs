<div 
  class="card bg-base-100 shadow-xl border border-base-300 hover:border-primary transition-all"
  x-bind:class="{ 'border-primary border-2': isSelected(package) }"
  x-on:click="selectPackage(package)"
>
  <figure class="px-4 pt-4">
    <img src="/images/uc-package.webp" alt="UC Package" class="rounded-xl h-48 object-contain" />
  </figure>
  <div class="card-body items-center text-center">
    <h2 class="card-title text-2xl font-bold text-primary">{{ucPoints}} UC</h2>
    <p class="text-xl font-semibold">${{amount}}</p>
    <div class="card-actions justify-center mt-4">
      <button 
        class="btn btn-primary btn-sm"
        x-bind:class="{ 'btn-outline': !isSelected(package) }"
      >
        <span x-show="!isSelected(package)">Select</span>
        <span x-show="isSelected(package)">Selected</span>
      </button>
    </div>
  </div>
</div> 