<div x-data="cartData()" class="w-full">
  <div class="bg-base-200 rounded-lg shadow-md p-6">
    <h2 class="text-2xl font-bold mb-6">Your Cart</h2>
    
    <div x-show="!selectedPackage" class="text-center p-6">
      <div class="text-lg text-neutral-content mb-4">Select a UC package to continue</div>
    </div>
    
    <div x-show="selectedPackage" class="mb-6">
      <div class="flex justify-between items-center p-4 bg-base-100 rounded-lg">
        <div>
          <h3 class="font-bold" x-text="selectedPackage?.ucPoints + ' UC'"></h3>
          <p class="text-sm opacity-70">PUBG Mobile Credits</p>
        </div>
        <div class="text-lg font-bold" x-text="'$' + selectedPackage?.amount"></div>
      </div>
    </div>
    
    <div x-show="error" class="alert alert-error mb-4" x-text="error"></div>
    
    <button 
      class="btn btn-primary w-full"
      x-bind:disabled="!selectedPackage || isProcessing"
      x-on:click="submitPurchase()"
    >
      <span x-show="!isProcessing">Proceed to Checkout</span>
      <span x-show="isProcessing" class="loading loading-spinner"></span>
    </button>
  </div>
</div> 