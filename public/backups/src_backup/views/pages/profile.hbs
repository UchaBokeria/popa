<div x-data="{
  user: window.initialData?.user || {},
  isEditing: false,
  formData: {
    username: '',
    email: '',
    fullName: '',
    pubgId: ''
  },
  error: '',
  success: '',
  
  init() {
    this.resetForm();
  },
  
  resetForm() {
    this.formData = {
      username: this.user.username || '',
      email: this.user.email || '',
      fullName: this.user.fullName || '',
      pubgId: this.user.pubgId || ''
    };
  },
  
  startEdit() {
    this.isEditing = true;
    this.error = '';
    this.success = '';
  },
  
  cancelEdit() {
    this.isEditing = false;
    this.resetForm();
  },
  
  async saveProfile() {
    try {
      const response = await fetch('/user/profile', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(this.formData)
      });
      
      const data = await response.json();
      
      if (data.success) {
        this.user = data.user;
        this.success = 'Profile updated successfully';
        this.isEditing = false;
      } else {
        this.error = data.message || 'Failed to update profile';
      }
    } catch (error) {
      this.error = 'An error occurred. Please try again.';
      console.error('Profile update error:', error);
    }
  }
}">
  <div class="max-w-2xl mx-auto">
    <div class="bg-base-200 rounded-lg shadow-md p-6">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold">Your Profile</h1>
        <button 
          x-show="!isEditing" 
          x-on:click="startEdit()" 
          class="btn btn-primary btn-sm"
        >
          Edit Profile
        </button>
      </div>
      
      <div x-show="success" class="alert alert-success mb-4" x-text="success"></div>
      <div x-show="error" class="alert alert-error mb-4" x-text="error"></div>
      
      <!-- View Mode -->
      <div x-show="!isEditing" class="space-y-4">
        <div class="flex items-center space-x-4">
          <div class="w-16 h-16 rounded-full bg-primary text-primary-content flex items-center justify-center">
            <span class="text-2xl" x-text="user.username ? user.username.charAt(0).toUpperCase() : ''"></span>
          </div>
          <div>
            <h2 class="text-xl font-bold" x-text="user.username"></h2>
            <p class="text-sm opacity-70" x-text="user.email"></p>
          </div>
        </div>
        
        <div class="divider"></div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <h3 class="font-semibold">Full Name</h3>
            <p x-text="user.fullName || 'Not provided'"></p>
          </div>
          
          <div>
            <h3 class="font-semibold">User ID</h3>
            <p x-text="user.pubgId || 'Not provided'"></p>
          </div>
          
          <div>
            <h3 class="font-semibold">Member Since</h3>
            <p x-text="user.createdAt ? new Date(user.createdAt).toLocaleDateString() : ''"></p>
          </div>
        </div>
        
        <div class="divider"></div>
        
        <div>
          <a href="/purchase/history" class="btn btn-outline btn-secondary">View Purchase History</a>
        </div>
      </div>
      
      <!-- Edit Mode -->
      <form x-show="isEditing" class="space-y-4" x-on:submit.prevent="saveProfile()">
        <div class="form-control">
          <label class="label">
            <span class="label-text">Username</span>
          </label>
          <input 
            type="text" 
            x-model="formData.username" 
            class="input input-bordered" 
            required 
          />
        </div>
        
        <div class="form-control">
          <label class="label">
            <span class="label-text">Email</span>
          </label>
          <input 
            type="email" 
            x-model="formData.email" 
            class="input input-bordered" 
            required 
          />
        </div>
        
        <div class="form-control">
          <label class="label">
            <span class="label-text">Full Name (Optional)</span>
          </label>
          <input 
            type="text" 
            x-model="formData.fullName" 
            class="input input-bordered" 
          />
        </div>
        
        <div class="form-control">
          <label class="label">
            <span class="label-text">User ID (Optional)</span>
          </label>
          <input 
            type="text" 
            x-model="formData.pubgId" 
            class="input input-bordered" 
          />
        </div>
        
        <div class="flex space-x-2 justify-end">
          <button type="button" x-on:click="cancelEdit()" class="btn btn-ghost">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div> 