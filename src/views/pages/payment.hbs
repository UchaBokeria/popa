<div class="max-w-md mx-auto">
  <div class="bg-base-200 rounded-lg shadow-md p-6">
    <h1 class="text-2xl font-bold mb-6">Complete Your Payment</h1>
    
    <div class="bg-base-100 p-4 rounded-lg mb-6">
      <div class="flex justify-between mb-2">
        <span>Product:</span>
        <span class="font-bold">{{purchase.ucPoints}} UC</span>
      </div>
      <div class="flex justify-between mb-2">
        <span>Price:</span>
        <span class="font-bold">${{purchase.amount}}</span>
      </div>
      <div class="flex justify-between">
        <span>Order ID:</span>
        <span class="font-bold">{{purchase.id}}</span>
      </div>
    </div>
    
    <form hx-post="/purchase/payment/{{purchase.id}}" hx-swap="outerHTML" class="space-y-4">
      <div class="form-control">
        <label class="label">
          <span class="label-text">Card Number</span>
        </label>
        <input type="text" placeholder="Card Number" class="input input-bordered" required />
      </div>
      
      <div class="grid grid-cols-2 gap-4">
        <div class="form-control">
          <label class="label">
            <span class="label-text">Expiry Date</span>
          </label>
          <input type="text" placeholder="MM/YY" class="input input-bordered" required />
        </div>
        
        <div class="form-control">
          <label class="label">
            <span class="label-text">CVC</span>
          </label>
          <input type="text" placeholder="CVC" class="input input-bordered" required />
        </div>
      </div>
      
      <div class="form-control">
        <label class="label">
          <span class="label-text">Name on Card</span>
        </label>
        <input type="text" placeholder="Name on Card" class="input input-bordered" required />
      </div>
      
      <div class="form-control mt-6">
        <button class="btn btn-primary">
          <span>Pay ${{purchase.amount}}</span>
        </button>
      </div>
    </form>
  </div>
</div> 