<div class="w-full">
  <h1 class="text-3xl font-bold mb-6">Purchase History</h1>
  
  {{#if purchases.length}}
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th>Date</th>
            <th>UC Points</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {{#each purchases}}
            <tr>
              <td>{{formatDate createdAt}}</td>
              <td>{{ucPoints}}</td>
              <td>${{amount}}</td>
              <td>
                {{#if (eq status "completed")}}
                  <span class="badge badge-success">{{status}}</span>
                {{else if (eq status "pending")}}
                  <span class="badge badge-warning">{{status}}</span>
                {{else}}
                  <span class="badge badge-error">{{status}}</span>
                {{/if}}
              </td>
              <td>
                {{#if (eq status "pending")}}
                  <a href="/purchase/payment/{{id}}" class="btn btn-primary btn-xs">Pay Now</a>
                {{else if (eq status "completed")}}
                  <a href="/purchase/success/{{id}}" class="btn btn-ghost btn-xs">View</a>
                {{else}}
                  <a href="/purchase" class="btn btn-outline btn-xs">Try Again</a>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <div class="bg-base-200 p-8 rounded-lg text-center">
      <h3 class="text-lg font-bold mb-2">No purchases yet</h3>
      <p class="mb-4">You haven't made any UC purchases yet.</p>
      <a href="/purchase" class="btn btn-primary">Buy UC Now</a>
    </div>
  {{/if}}
</div> 