<!DOCTYPE html>
<html data-theme="popaTheme" lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Popa</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/styles/tailwind.css">
  <script src="/node_modules/htmx.org/dist/htmx.min.js"></script>
  <script defer src="/node_modules/alpinejs/dist/cdn.min.js"></script>
  {{#if alpineData}}
  <script>
    window.initialData = {{{alpineData}}};
  </script>
  {{/if}}
</head>
<body class="min-h-screen flex flex-col bg-base-100">
  {{!-- {{> components/navbar }} --}}
  
  <main class="flex-grow container mx-auto px-4 py-8">
    {{{content}}}
  </main>
  
  <footer class="bg-neutral text-neutral-content py-6">
    <div class="container mx-auto px-4 text-center">
      <p>&copy; {{currentYear}} Popa. All rights reserved.</p>
    </div>
  </footer>
</body>
</html> 